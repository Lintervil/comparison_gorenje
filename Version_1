// ==UserScript==
// @name         Gorenje: расширенная проверка сравнения (v1.3.0)
// @namespace    https://gorenje-ru.ru/
// @version      1.3.0
// @description  Локальная сверка карточек Gorenje с Битрикс-интеграцией
// @match        https://gorenje-ru.ru/compare/*
// @match        https://gorenje-ru.ru/catalog/*.html
// @match        https://gorenje-ru.ru/catalog/*/*.html
// @match        https://gorenje-ru.ru/catalog/*/*/*.html
// @match        https://gorenje-ru.ru/catalog/*/*/*/*.html
// @match        https://gorenje-ru.ru/bitrix/admin/iblock_element_edit.php*
// @run-at       document-idle
// @grant        GM_xmlhttpRequest
// @grant        GM.xmlHttpRequest
// @connect      gorenje-ru.ru
// ==/UserScript==
(function () {
"use strict";
const ROW_SELECTOR = ".compare-table-block__row.js-compare-row, .characteristics__row";
const PANEL_ID = "gcv-panel";
const STATUS_RANK = { ok: 0, warning: 1, error: 2 };
const BITRIX_IBLOCK_ID = 1099;
let hasRun = false, hasStarted = false, runInProgress = false, runSequence = 0, autoTimer = null;
const editUrlCache = new Map();
let openPopover = null, popoverListenersReady = false;

function normalize(v){return String(v??"").normalize("NFKC").replace(/\u00a0/g," ").replace(/[\u200B-\u200D\uFEFF]/g,"").replace(/(\d),(\d)/g,"$1.$2").replace(/×/g,"x").replace(/(\d)\s*[хХ]\s*(?=\d)/g,"$1 x ");}
function normalizeLabel(v){return normalize(v).replace(/\s+источник\s*$/,"").replace(/\s*\*+\s*$/,"");}
function sourceUrl(){return window.location.href;}
function isProductPage(){return window.location.pathname.includes('/catalog/');}
function pageMode(){return isProductPage()?"product":"compare";}
function isAdminPage(){return window.location.pathname.includes("/bitrix/admin/iblock_element_edit.php");}

function numbersOf(v){return(normalize(v).match(/\d+(?:\.\d+)?/g)||[]).map(Number);}
function numberOf(v){const n=numbersOf(v);return n.length?n[0]:null;}
function isMissing(v){const k=normalize(v).replace(/[\u2020*]+/g,"").trim();return!k||/^(?:не указано|неизвестно|[-—–])$/.test(k);}
function isNegative(v){const k=normalize(v);return/^(?:нет|no|[-—–]|false|отсутствует)$/.test(k)||k==="0";}
function isPositive(v){const k=normalize(v);return/^(?:да|есть|\+|yes|true|имеется|присутствует)$/.test(k)||k==="1";}
function booleanKey(v){const k=normalize(v);if(/^(?:да|есть|\+|yes|true|имеется|присутствует)$/.test(k)||k==="1")return"yes";if(/^(?:нет|no|-|false|отсутствует)$/.test(k)||k==="0")return"no";return null;}

function unitInfo(v){
const k=normalize(v);
if(/(?:^|[\s,(])(?:квтч|квт\/ч|kwh)(?:$|[\s,.)])/.test(k))return{group:"energy",factor:1,name:"кВт·ч"};
if(/(?:^|[\s,(])квт(?:$|[\s,.)])/.test(k))return{group:"power",factor:1000,name:"кВт"};
if(/(?:^|[\s,(])вт(?:$|[\s,.)])/.test(k))return{group:"power",factor:1,name:"Вт"};
if(/(?:^|[\s,(])мм(?:$|[\s,.)])/.test(k))return{group:"length",factor:1,name:"мм"};
if(/(?:^|[\s,(])см(?:$|[\s,.)])/.test(k))return{group:"length",factor:10,name:"см"};
if(/(?:^|[\s,(])кг(?:$|[\s,.)])/.test(k))return{group:"weight",factor:1,name:"кг"};
if(/(?:^|[\s,(])л(?:$|[\s,.)])/.test(k))return{group:"volume",factor:1,name:"л"};
if(/(?:°c|градус)/.test(k))return{group:"temperature",factor:1,name:"°C"};
if(/(?:об\s*\/\s*мин|об\s+мин)/.test(k))return{group:"speed",factor:1,name:"об/мин"};
return null;
}
function unitsForLabel(l,v){return unitInfo(l)||unitInfo(v)||{group:"number",factor:1,name:""};}

function valuesEqual(f,s){
const lb=booleanKey(f),rb=booleanKey(s);if(lb&&rb)return lb===rb;
const su=v=>normalize(v).replace(/[\u2020*]+/g,"").replace(/(?:квтч|квт\/ч|квт|вт|см|мм|кг|°c|°|градусов|кwh|kwh)/g," ").replace(/\s+/g," ").trim();
const l=su(f),r=su(s);if(!l||!r)return l===r;
if(l===r||l.includes(r)||r.includes(l))return true;
const ln=numbersOf(l),rn=numbersOf(r);
if(ln.length>0&&ln.length===rn.length&&(ln.every((n,i)=>Math.abs(n-rn[i])<0.01)||ln.slice().sort((a,b)=>a-b).every((n,i)=>Math.abs(n-rn.slice().sort((a,b)=>a-b)[i])<0.01)))return true;
const lk=v=>normalize(v).replace(/климатический класс|температурные режимы/g," ").split(/[^a-zа-яё0-9]+/).filter(Boolean).sort().join(" ");
if(/климатический класс/.test(l+r)&&lk(l)===lk(r))return true;
return false;
}

function compareNumberPart(lv,ov,lu,ou){
const l=numbersOf(lv).map(n=>n*(lu?.factor||1)),o=numbersOf(ov).map(n=>n*(ou?.factor||1));
if(!l.length||!o.length)return null;
if(lu?.group&&ou?.group&&lu.group!==ou.group)return false;
if(l.length===o.length)return l.every((n,i)=>Math.abs(n-o[i])<0.01);
if(l.length===1&&o.length>1)return l[0]>=Math.min(...o)-0.01&&l[0]<=Math.max(...o)+0.01;
if(o.length===1&&l.length>1)return o[0]>=Math.min(...l)-0.01&&o[0]<=Math.max(...l)+0.01;
return false;
}

function parseDimensionParts(v){return normalize(v).replace(/(?:см|мм)/g,"").split(/\s*x\s*/).map(p=>numbersOf(p));}
function dimensionFormatIssues(v,title=""){
const raw=String(v??"").trim(),issues=[];
if(!/\d\s*[xх×]\s*\d/i.test(raw))return issues;
const parts=raw.split(/\s*[xх×]\s*/i).filter(p=>/\d/.test(p));
const isTriplet=parts.length>=3;
const isDim=/размер|габарит|ниш|высот|ширин|глубин/i.test(String(title));
if(!isTriplet&&!isDim)return issues;
if(/(?:\d\s*x\s*\d|\d+x\d)/i.test(raw))issues.push("использована английская «x»; нужен русский разделитель «х»");
else if(/\d\s*×\s*\d/.test(raw))issues.push("использован знак «×»; нужен русский разделитель «х»");
return issues;
}

function textOf(e){if(!e)return"";const c=e.cloneNode(true);c.querySelectorAll(".glossary-tooltip,.gcv-badge,.gcv-source,.gcv-cell-source,.gcv-info-button,.gcv-edit-card").forEach(i=>i.remove());return String(c.innerText||c.textContent||"").replace(/\s+/g," ").trim();}

function readTable(){
const s=isProductPage()?".characteristics__row":".compare-table-block__row.js-compare-row";
return[...document.querySelectorAll(s)].map(el=>{
const te=el.querySelector(isProductPage()?".characteristics__name":".js-compare-cell-title");
let vs=[];
if(isProductPage())vs=[textOf(el.querySelector(".characteristics__property"))];
else vs=[...el.querySelectorAll(".swiper-wrapper > .compare-table-block__cell.js-compare-cell")].map(textOf);
return{element:el,title:textOf(te),titleElement:te,values:vs};
}).filter(r=>r.title);
}
function rowCells(r){if(isProductPage())return[r.element.querySelector(".characteristics__property")];return[...r.element.querySelectorAll(".swiper-wrapper > .compare-table-block__cell.js-compare-cell")];}
function findRow(rs,p){return rs.find(r=>p.test(normalizeLabel(r.title)));}

function readProducts(rs){
if(isProductPage()){const h1=document.querySelector('h1');const n=h1?h1.textContent.trim():document.title;const ar=findRow(rs,/^артикул/);const p={name:n,href:window.location.href,id:"",article:textOf(ar?.titleElement)};return[p];}
const ar=findRow(rs,/^артикул/);
return[...document.querySelectorAll(".comparison-card.swiper-slide")].map((c,i)=>{const t=c.querySelector(".comparison-card__type-and-title");const rb=c.querySelector(".js-compare_remove");const p={name:textOf(t),href:rb?.href||"",id:"",article:ar?textOf(ar.values[i]||""):"",editBase:""};return p;});
}
function productLabel(ps,i){const p=ps[i];if(!p)return`товар №${i+1}`;return p.name+(p.id?` (ID ${p.id})`:"");}

async function fetchEditBaseUrl(p){
const k=p.id||p.href;if(editUrlCache.has(k))return editUrlCache.get(k);
let url="";const d=document.querySelector('a.ctrl-btn[href*="iblock_element_edit"]');
if(pageMode()==="product"&&d)url=d.href;
if(!url&&p.id)url=`https://gorenje-ru.ru/bitrix/admin/iblock_element_edit.php?IBLOCK_ID=${BITRIX_IBLOCK_ID}&type=gr_catalog&lang=ru&ID=${p.id}&find_section_section=-1&WF=Y`;
editUrlCache.set(k,url);return url;
}
function editUrl(p,f){const b=p?.editBase||editUrlCache.get(p?.id||p?.href)||"";if(!b)return"";return b.split("#")[0]+(f?"#gcv="+encodeURIComponent(f):"");}

function findAdminFieldRow(t){
let best=null;document.querySelectorAll("td,th,label,span,b,div").forEach(el=>{
if(el.children.length>2)return;const tx=normalizeLabel(el.textContent||"");
if(!tx||tx.length>t.length+30)return;
if(tx===t||tx.startsWith(t)||(t.startsWith(tx)&&tx.length>5)){if(!best||el.textContent.length<best.textContent.length)best=el;}
});if(!best)return null;return best.closest("tr")||best.closest(".adm-detail-content-item")||best.parentElement;
}
function highlightAdminRow(r){
const s=document.createElement("style");s.textContent=`.gcv-admin-target{outline:3px solid #ff6600!important;outline-offset:2px;background:#fff3e0!important;}.gcv-admin-target-input{outline:2px solid #ff6600!important;}`;
document.head.appendChild(s);r.scrollIntoView({block:"center",behavior:"smooth"});r.classList.add("gcv-admin-target");
r.querySelectorAll("input,select,textarea").forEach(i=>i.classList.add("gcv-admin-target-input"));
}
function initAdminHighlight(){
const m=location.hash.match(/^#gcv=(.+)$/);if(!m)return;
const t=normalizeLabel(decodeURIComponent(m[1]));if(!t)return;
let tr=0;const ti=setInterval(()=>{tr+=1;const r=findAdminFieldRow(t);if(r){clearInterval(ti);highlightAdminRow(r);}else if(tr>40)clearInterval(ti);},250);
}

function emptyResult(){return{rowResults:new Map(),cellResults:new Map(),findings:[]};}
function addDetail(t,d){if(!d)return;if(!t.details)t.details=[];const s=`${d.label||""}|${d.value||""}`;if(!t.details.some(i=>`${i.label||""}|${i.value||""}`===s))t.details.push(d);}
function noteResult(r,row,i,s,m,tt,src="",af=true,d=null){
if(!row)return;
const pr=r.rowResults.get(row)||{status:"ok",messages:new Set(),tooltips:new Set()};
if(STATUS_RANK[s]>STATUS_RANK[pr.status])pr.status=s;
pr.messages.add(m);if(tt)pr.tooltips.add(tt);addDetail(pr,d);r.rowResults.set(row,pr);
const c=rowCells(row)[i];
if(c){
const pc=r.cellResults.get(c)||{status:"ok",messages:new Set(),tooltips:new Set(),sources:new Set()};
if(STATUS_RANK[s]>STATUS_RANK[pc.status])pc.status=s;
pc.messages.add(m);pc.productIndex=i;pc.rowTitle=row.title;
if(tt)pc.tooltips.add(tt);if(src)pc.sources.add(src);addDetail(pc,d);r.cellResults.set(c,pc);
}
if(af&&s!=="ok")r.findings.push(m);
}

function runLocalValidation(rows,products){
const r=emptyResult();
rows.forEach(row=>{row.values.forEach((v,i)=>{
const is=dimensionFormatIssues(v,row.title);if(!is.length)return;
const m=`${row.title}: ${is.join("; ")} у ${productLabel(products,i)}`;
noteResult(r,row,i,"error",m,is.join("; "));
});});
return r;
}

function closePopover(){if(!openPopover)return;openPopover.element.remove();openPopover=null;}
function ensurePopoverListeners(){if(popoverListenersReady)return;popoverListenersReady=true;document.addEventListener("click",e=>{if(!openPopover)return;if(e.target.closest(".gcv-popover,.gcv-info-button"))return;closePopover();});}
function showPopover(cell,item,btn){
ensurePopoverListeners();closePopover();
const p=document.createElement("div");p.className="gcv-popover";p.setAttribute("role","dialog");
const h=document.createElement("div");h.className="gcv-popover-head";
const t=document.createElement("strong");t.textContent=item.status==="error"?"Расхождение":"Подробности проверки";
const c=document.createElement("button");c.type="button";c.className="gcv-popover-close";c.textContent="×";c.addEventListener("click",closePopover);
h.append(t,c);p.appendChild(h);
const ds=item.details||[];
if(ds.length){ds.forEach(d=>{const r=document.createElement("div");r.className="gcv-popover-row";const v=document.createElement("span");v.textContent=`${d.label?`${d.label}: `:""}${d.value||"пусто"}`;r.appendChild(v);p.appendChild(r);});}
else Array.from(item.messages||[]).forEach(m=>{const r=document.createElement("div");r.className="gcv-popover-message";r.textContent=m;p.appendChild(r);});
document.body.appendChild(p);
const br=btn.getBoundingClientRect(),pr=p.getBoundingClientRect();
const l=Math.min(Math.max(8,br.left),window.innerWidth-pr.width-8);
const bel=br.bottom+8;const tp=bel+pr.height<=window.innerHeight-8?bel:Math.max(8,br.top-pr.height-8);
p.style.left=`${l}px`;p.style.top=`${tp}px`;
openPopover={element:p,button:btn};
}

function removeAnnotations(){closePopover();document.querySelectorAll(".gcv-badge,.gcv-source,.gcv-cell-source,.gcv-info-button,.gcv-edit-card").forEach(i=>i.remove());document.querySelectorAll(ROW_SELECTOR).forEach(r=>r.classList.remove("gcv-row-ok","gcv-row-warning","gcv-row-error"));}
function renderResults(r,ps){
removeAnnotations();
r.rowResults.forEach((i,row)=>row.element.classList.add(`gcv-row-${i.status}`));
r.cellResults.forEach((i,cell)=>{
if(!cell)return;
const b=document.createElement("span");b.className=`gcv-badge gcv-badge-${i.status}`;b.textContent=i.status==="error"?"❌":i.status==="warning"?"⚠️":"✅";
b.style.cssText="margin-left:8px;font-size:14px;";cell.append(" ",b);
if((i.details||[]).length||i.messages?.size){const inf=document.createElement("button");inf.type="button";inf.className="gcv-info-button";inf.textContent="ℹ";inf.addEventListener("click",()=>{showPopover(cell,i,inf);});cell.append(" ",inf);}
if(i.status!=="ok"&&i.productIndex!=null&&ps[i.productIndex]){const hr=editUrl(ps[i.productIndex],i.rowTitle);if(hr){const a=document.createElement("a");a.className="gcv-cell-source";a.href=hr;a.target="_blank";a.rel="noreferrer";a.textContent="→Редактировать";a.style.cssText="margin-left:8px;color:#0066cc;text-decoration:underline;cursor:pointer;";cell.append(" ",a);}}
});
}

function ensurePanel(){
let p=document.getElementById(PANEL_ID);if(p)return p;
const s=document.createElement("style");
s.textContent=`#${PANEL_ID}{position:fixed;z-index:2147483646;top:14px;right:14px;width:min(430px,calc(100vw - 28px));max-height:calc(100vh - 28px);overflow:auto;background:#fff;color:#17212b;border:1px solid #e5e5e5;border-radius:4px;box-shadow:0 2px 8px rgba(0,0,0,0.15);font-family:system-ui,sans-serif;font-size:13px;}.gcv-head{display:flex;justify-content:space-between;align-items:center;padding:10px;background:#f5f5f5;border-bottom:1px solid #e5e5e5;}.gcv-title{font-weight:bold;}.gcv-head button{background:none;border:none;cursor:pointer;color:#0066cc;}.gcv-body{padding:10px;}.gcv-collapsed .gcv-body{display:none;}.gcv-summary{margin:0 0 10px 0;font-weight:bold;}.gcv-note{margin:5px 0;padding:8px;background:#fff9e6;border-left:3px solid #ffc107;}.gcv-list{margin:0;padding:0 0 0 20px;}.gcv-list li{margin:4px 0;}.gcv-popover{position:fixed;background:#fff;border:1px solid #ccc;border-radius:4px;box-shadow:0 2px 8px rgba(0,0,0,0.2);z-index:2147483647;max-width:300px;}.gcv-popover-head{padding:8px 10px;border-bottom:1px solid #eee;display:flex;justify-content:space-between;align-items:center;background:#f9f9f9;}.gcv-popover-close{background:none;border:none;font-size:18px;cursor:pointer;color:#999;}.gcv-popover-row,.gcv-popover-message{padding:6px 10px;border-bottom:1px solid #f0f0f0;word-wrap:break-word;}.gcv-row-error{background:#ffe6e6!important;}.gcv-row-warning{background:#fff9e6!important;}.gcv-row-ok{background:#e6f7e6!important;}.gcv-badge{display:inline-block;}.gcv-info-button{background:#0066cc;color:#fff;border:none;border-radius:50%;width:18px;height:18px;padding:0;cursor:pointer;font-size:12px;}.gcv-cell-source{display:inline-block;margin-left:8px;color:#0066cc;text-decoration:underline;cursor:pointer;font-size:12px;}`;
document.head.appendChild(s);
p=document.createElement("section");p.id=PANEL_ID;
p.innerHTML=`<div class="gcv-head"><span class="gcv-title">Проверка сравнения v1.3.0</span><button data-action="toggle">Скрыть</button></div><div class="gcv-body"><div style="text-align:center;"><button data-action="run" style="padding:6px 12px;background:#0066cc;color:#fff;border:none;border-radius:3px;cursor:pointer;">Запустить проверку</button></div><div class="gcv-output"></div></div>`;
p.querySelector('[data-action="run"]').addEventListener("click",()=>runChecks());
p.querySelector('[data-action="toggle"]').addEventListener("click",e=>{p.classList.toggle("gcv-collapsed");e.currentTarget.textContent=p.classList.contains("gcv-collapsed")?"Показать":"Скрыть";});
document.body.appendChild(p);return p;
}
function renderPanel(r,ps){
const p=ensurePanel(),o=p.querySelector(".gcv-output");
const errs=[...r.rowResults.values()].filter(i=>i.status==="error").length;
const warns=[...r.rowResults.values()].filter(i=>i.status==="warning").length;
o.replaceChildren();
const sm=document.createElement("p");sm.className="gcv-summary";sm.textContent=`Ошибок: ${errs}. Предупреждений: ${warns}. Проверено: ${r.rowResults.size}.`;o.appendChild(sm);
const fs=[...new Set(r.findings)];
if(!fs.length){const ok=document.createElement("p");ok.textContent="✅ Ошибок не найдено.";o.appendChild(ok);return;}
const l=document.createElement("ul");l.className="gcv-list";fs.forEach(m=>{const i=document.createElement("li");i.textContent=m;l.appendChild(i);});o.appendChild(l);
}

async function waitForStableTable(){let pc=0,sp=0;for(let a=0;a<14;a+=1){const c=readTable().length;if(c>0&&c===pc)sp+=1;else sp=0;if(sp>=2)return;pc=c;await new Promise(r=>window.setTimeout(r,500));}}
async function runChecks(){
if(runInProgress)return;runInProgress=true;
await waitForStableTable();
const rows=readTable();
if(rows.length<1){renderPanel({...emptyResult(),findings:[`Таблица не найдена: ${window.location.href}`]},[], false);runInProgress=false;return;}
const cr=++runSequence;hasRun=true;
const ps=readProducts(rows);
const ep=Promise.all(ps.map(p=>fetchEditBaseUrl(p).then(u=>{p.editBase=u;})));
const lr=runLocalValidation(rows,ps);
renderResults(lr,ps);renderPanel(lr,ps);
await ep;if(cr!==runSequence)return;
renderResults(lr,ps);
renderPanel(lr,ps);runInProgress=false;
}
function start(){
if(hasStarted)return;hasStarted=true;ensurePanel();
const obs=new MutationObserver(()=>{if(hasRun||runInProgress||document.querySelectorAll(ROW_SELECTOR).length<1)return;window.clearTimeout(autoTimer);autoTimer=window.setTimeout(()=>runChecks(),1000);});
obs.observe(document.body,{childList:true,subtree:true});
autoTimer=window.setTimeout(()=>runChecks(),1500);
}

if(isAdminPage()){if(document.readyState==="loading")document.addEventListener("DOMContentLoaded",initAdminHighlight,{once:true});else initAdminHighlight();}
else if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",start,{once:true});}
else{start();window.addEventListener("load",start,{once:true});}
})();