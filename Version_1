async function waitForStableTable(){let pc=0,sp=0;for(let a=0;a<14;a+=1){const c=readTable().length;if(c>0&&c===pc)sp+=1;else sp=0;if(sp>=2)return;pc=c;await new Promise(r=>window.setTimeout(r,500));}}
async function runChecks(){
if(runInProgress)return;runInProgress=true;
await waitForStableTable();
const rows=readTable();
if(rows.length<1){renderPanel({...emptyResult(),findings:[`Таблица не найдена: ${window.location.href}`]},[], false);runInProgress=false;return;}
const cr=++runSequence;hasRun=true;
const ps=readProducts(rows);
const ep=Promise.all(ps.map(p=>fetchEditBaseUrl(p).then(u=>{p.editBase=u;})));
const lr=runLocalValidation(rows,ps);
renderResults(lr,ps);renderPanel(lr,ps,true);
const apiKey=document.querySelector(`#${PANEL_ID} [data-action="key"]`)?.value.trim()||"";
try{const or=await runOfficialValidation(rows,ps,apiKey);if(cr!==runSequence)return;mergeResults(lr,or);}catch(e){console.error("[GCV] err:",e);lr.findings.push(`⚠️ Внутренняя ошибка: ${e?.message||e}`);}
await ep;if(cr!==runSequence)return;
renderResults(lr,ps);renderProductEditLinks(ps);
if(pageMode()==="product")patchCardEditButton(lr,rows);
renderPanel(lr,ps,false);runInProgress=false;
}
function start(){
if(hasStarted)return;hasStarted=true;ensurePanel();
const obs=new MutationObserver(()=>{if(hasRun||runInProgress||document.querySelectorAll(ROW_SELECTOR).length<1)return;window.clearTimeout(autoTimer);autoTimer=window.setTimeout(()=>runChecks(),1000);});
obs.observe(document.body,{childList:true,subtree:true});
autoTimer=window.setTimeout(()=>runChecks(),1500);
}

