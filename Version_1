if(!rec||rec.error){summary.unknown+=1;noteResult(result,row,i,"warning",`⚠️ ОФИЦИАЛЬНЫЙ ИСТОЧНИК: ${row.title} не проверен для ${productLabel(products,i)} (${rec?.error||"нет записи"})`,"Не найдено на оф. сайте",rec?.url||"",true,{label:"Официальный источник",value:rec?.error||"Карточка не найдена",source:rec?.url||"",anchorLabel:""});continue;}
let ref=findReference(row.title,lv,rec);
if(!ref&&!isMissing(lv)&&apiKey){
const mn=products[i]?.model||rec?.model||"";
if(mn){try{const ai=await findEvidence(products[i],row.title,lv,apiKey);if(ai.modelUsed)summary.modelUsed=ai.modelUsed;if(ai.status==="ok"||ai.sources.length){ref={entry:{label:`AI: ${row.title}`,value:ai.answer||"найдено через Gemini",sourceUrl:ai.sources[0]?.url||""},localMeta:null,kind:"ai-search"};}}catch(e){console.warn("[GCV] AI fail:",e);}}
}
if(!ref){summary.unknown+=1;noteResult(result,row,i,"warning",`⚠️ ОФИЦИАЛЬНЫЙ ИСТОЧНИК: характеристика «${row.title}» не найдена у ${productLabel(products,i)}`,"Нет на оф. сайте",rec.url,true,{label:row.title,value:"Поле не найдено на официальном сайте",source:rec.url,anchorLabel:row.title});continue;}
const cmp=compareReference(lv,row.title,ref);
const st=cmp===null?"warning":cmp?"ok":"error";
if(st==="ok"){summary.confirmed+=1;if(ref.kind==="ai-search")summary.aiConfirmed+=1;}
if(st==="error")summary.mismatches+=1;
if(st==="warning")summary.unknown+=1;
const pr=st==="ok"?"✅":st==="error"?"❌":"⚠️";
const mk=ref.kind==="fuzzy"?" [FUZZY]":ref.kind==="ai-search"?" [AI]":"";
const msg=`${pr} ОФИЦИАЛЬНЫЙ ИСТОЧНИК${mk}: «${row.title}» → «${ref.entry.label}» у ${productLabel(products,i)}; локально «${lv||"пусто"}», официально «${formatOfficialValue(ref.entry.value,row.title)||"пусто"}»`;
const tt=st==="error"?`На оф. сайте: ${formatOfficialValue(ref.entry.value,row.title)}`:(st==="warning"?"Нет на оф. сайте":"");
noteResult(result,row,i,st,msg,tt,ref.entry.sourceUrl||rec.url,true,{label:ref.entry.label,value:formatOfficialValue(ref.entry.value,row.title)||"пусто",source:ref.entry.sourceUrl||rec.url,anchorLabel:ref.entry.anchorLabel||ref.entry.label});
}
}
records.forEach((r,i)=>{if(!r||r.error||!r.featureNames?.length)return;r.featureNames.forEach(fn=>{const lm=rows.some(row=>featureNameMatches(row.title,row.values[i]||"",fn));if(!lm)result.findings.push(`⚠️ ОФИЦИАЛЬНАЯ ФУНКЦИЯ: «${fn}» есть у ${productLabel(products,i)}, но локального поля для сравнения нет`);});});
result.officialSummary=summary;return result;
}
function mergeResults(t,e){
e.rowResults.forEach((i,row)=>{const p=t.rowResults.get(row)||{status:"ok",messages:new Set(),tooltips:new Set(),details:[]};if(STATUS_RANK[i.status]>STATUS_RANK[p.status])p.status=i.status;i.messages.forEach(m=>p.messages.add(m));if(i.tooltips)i.tooltips.forEach(x=>p.tooltips.add(x));(i.details||[]).forEach(d=>addDetail(p,d));t.rowResults.set(row,p);});
e.cellResults.forEach((i,cell)=>{const p=t.cellResults.get(cell)||{status:"ok",messages:new Set(),tooltips:new Set(),sources:new Set(),details:[]};if(STATUS_RANK[i.status]>STATUS_RANK[p.status])p.status=i.status;i.messages.forEach(m=>p.messages.add(m));if(i.tooltips)i.tooltips.forEach(x=>p.tooltips.add(x));(i.sources||[]).forEach(s=>p.sources.add(s));(i.details||[]).forEach(d=>addDetail(p,d));t.cellResults.set(cell,p);});
t.findings.push(...e.findings);t.officialSummary=e.officialSummary;
}

