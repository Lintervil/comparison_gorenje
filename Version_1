  function dimensionSourceOrder(label, fallback = ["height", "width", "depth"]) {
    const key = normalizeLabel(label)
      .replace(/\bширина\b/g, "ш")
      .replace(/\bвысота\b/g, "в")
      .replace(/\bглубина\b/g, "г")
      .replace(/\s+/g, " ");
    if (/ш\s*x\s*в\s*x\s*г/.test(key)) return ["width", "height", "depth"];
    if (/в\s*x\s*ш\s*x\s*г/.test(key)) return ["height", "width", "depth"];
    return fallback;
  }

  function dimensionDisplay(value, label = "") {
    const parts = parseDimensionParts(value);
    if (parts.length !== 3) return String(value ?? "").replace(/(\d),(\d)/g, "$1.$2");
    const order = dimensionSourceOrder(label);
    const byName = Object.fromEntries(order.map((name, index) => [name, parts[index]]));
    return ["height", "width", "depth"].map((name) => byName[name]?.[0] ?? "").join(" х ");
